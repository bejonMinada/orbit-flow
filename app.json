{
  "expo": {
    "name": "OrbitFlow",
    "slug": "orbit-flow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bejonminada.orbitflow"
    },
    "android": {
      "package": "com.bejonminada.orbitflow",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker"
    ]
  }
}
